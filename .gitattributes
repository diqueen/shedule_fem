# Normalize line endings: LF in the repository, regardless of the OS.
* text=auto eol=lf

# Shell scripts must always use LF, otherwise the Linux container breaks.
*.sh text eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary files must never be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
