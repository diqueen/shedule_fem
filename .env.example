# Telegram bot token (получить у @BotFather)
BOT_TOKEN=123456789:REPLACE_ME

# PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/schedule_bot

# Часовой пояс приложения
TIMEZONE=Europe/Moscow

# Время ежедневной рассылки расписания на завтра (HH:MM, локальное время TIMEZONE)
SCHEDULE_SEND_TIME=20:00

# TTL кэша месячного расписания в секундах
SCHEDULE_CACHE_TTL=3600

# Основной источник расписания и резервные зеркала (через запятую)
SCHEDULE_URL=https://gtifem.ru/dekanat/raspisanie/
SCHEDULE_URL_FALLBACKS=https://gtifem.technolog.edu.ru/dekanat/raspisanie/

# Telegram ID администраторов через запятую
ADMIN_IDS=

# Уровень логирования
LOG_LEVEL=INFO

# Каталог для сохранения HTML при ошибке парсинга (пусто — не сохранять)
DEBUG_HTML_DIR=

# Не проверять TLS-сертификат (зеркало gtifem.technolog.edu.ru имеет просроченный сертификат)
SCHEDULE_TLS_VERIFY=false
